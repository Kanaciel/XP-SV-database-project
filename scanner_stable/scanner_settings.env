# Scanner settings. Copy this file to "scanner_settings.env" (same folder),
# remove the # in front of a line and change its value.
# One NAME=value per line. Quotes are optional. Lines starting with # are ignored.
# Environment variables, if set, win over this file.

# Database file. Relative paths are relative to this folder.
XPSV_DB_PATH=test_reports.db

# Minutes between scan cycles.
XPSV_SCAN_INTERVAL_MINUTES=30

# Seconds to pause after each new file (eases the load on the stations).
XPSV_FILE_DELAY_SECONDS=0.05

# Max NEW files per station per cycle. None = no limit. Handy for testing (e.g. 5).
XPSV_MAX_FILES_PER_TARGET=None

# Reports saved per database commit.
XPSV_BATCH_SIZE=100

# Log folder and level (debug, info, warning, error).
XPSV_LOG_DIR=logs
XPSV_LOG_LEVEL=info

# Seconds to wait if another program is writing to the database.
XPSV_DB_BUSY_TIMEOUT=30

# Password encryption scope: user (default) or machine. See README "Passwords".
XPSV_DPAPI_SCOPE=user
